# Django Production Environment Variables
# Create a copy of this file as .env and fill in the values for local development.
# In production, set these variables in the platform dashboard (e.g. Railway, Render).

# Security Settings
SECRET_KEY=generate-a-secure-random-string
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com,your-backend-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://your-frontend-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://your-frontend-app.vercel.app

# Database
# Uses PostgreSQL in production. Use a standard SQLite URL or Postgres URL for local dev.
DATABASE_URL=postgres://user:password@hostname:port/dbname

# Sentry / Error Monitoring
SENTRY_DSN=your_sentry_dsn_here

# Contact Email System (Deferred)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_api_key
# DEFAULT_FROM_EMAIL=contact@yourdomain.com
# NOTIFICATION_EMAIL=your@email.com

# Admin Account Auto-creation (for Render deployment script)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=secure_password_here
