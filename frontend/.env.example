# Frontend Production Environment Variables
# Create a copy of this file as .env.local for local development.
# In production (Vercel), set these in the Project Settings > Environment Variables.

# The base URL of the backend API
# Example for local development:
# VITE_API_URL=http://127.0.0.1:8000
# Example for production:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=https://your-backend-app.up.railway.app

# Optional: Sentry for frontend
# VITE_SENTRY_DSN=your_frontend_sentry_dsn_here
